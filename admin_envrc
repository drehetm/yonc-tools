# To apply this configuration, run the following command from the root of the repository `yonc-router-admin`:
# ln -sf ../yonc-tools/admin_envrc .envrc
# direnv allow

# Check whether the project's virtual environment has already been created.
if [[ ! -d ".venv" ]]; then
    # Create the virtual environment in .venv using uv.
    uv venv .venv
fi

# Install and synchronize every project dependency group from uv.lock into .venv.
uv sync --all-groups

# Activate .venv so Python commands and editor integrations use this environment.
source .venv/bin/activate

# Resolve the repository's pre-commit hook path, suppressing errors outside a Git repository.
_admin_pre_commit_hook="$(git rev-parse --git-path hooks/pre-commit 2>/dev/null)"
# Continue only when Git returned the path where the pre-commit hook belongs.
if [[ -n "${_admin_pre_commit_hook}" ]]; then
    # Recreate a missing, non-executable, invalid, or non-pre-commit hook.
    if [[ ! -x "${_admin_pre_commit_hook}" ]] ||
        ! grep -qF "# File generated by pre-commit:" "${_admin_pre_commit_hook}" 2>/dev/null ||
        ! bash -n "${_admin_pre_commit_hook}" 2>/dev/null; then
        # Install the Git hook and prepare every hook environment from the configuration.
        uvx pre-commit install --install-hooks
    fi
fi
# Remove the temporary hook-path variable from the interactive shell environment.
unset _admin_pre_commit_hook

